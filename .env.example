# Copy to .env and fill in. NEVER commit .env.
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=change-me
AIRFLOW_ALLOWED_DAGS=training_pipeline
K8S_NAMESPACE=mlops-demo
K8S_ALLOWED_NAMESPACES=mlops-demo
K8S_APP_LABEL=app=ml-inference
REPO_PATH=.
# Free key from https://aistudio.google.com/apikey . Enables Gemini function calling.
# Without it a deterministic rule planner is used (offline fallback).
GEMINI_API_KEY=
AGENT_LLM_MODEL=gemini-2.5-flash
MIN_QUALITY_F1=0.80
MODEL_FRESHNESS_DAYS=30
